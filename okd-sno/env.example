# Kopieren nach ./env und anpassen:  cp env.example env
# Alle Skripte lesen diese Datei automatisch ein.

# --- OKD Version -------------------------------------------------------------
# Leer lassen = neuestes Release von github.com/okd-project/okd verwenden.
# Beispiel fuer eine feste Version: OKD_VERSION="4.19.0-okd-scos.19"
OKD_VERSION=""

# --- Installationsmethode -----------------------------------------------------
# agent             = Agent-based Installer (empfohlen, statische IP moeglich)
# bootstrap-in-place = klassische SNO-Methode mit Live-ISO + Ignition (DHCP)
INSTALL_METHOD="agent"

# --- Cluster ------------------------------------------------------------------
CLUSTER_NAME="sno"
BASE_DOMAIN="lab.local"          # => api.sno.lab.local, *.apps.sno.lab.local

# --- Netzwerk des Knotens ------------------------------------------------------
NODE_HOSTNAME="sno"
NODE_IP="192.168.122.10"
NODE_PREFIX="24"
NODE_GATEWAY="192.168.122.1"
NODE_DNS="192.168.122.1"
NODE_INTERFACE="enp1s0"          # Name der NIC im Knoten
NODE_MAC="52:54:00:00:00:10"     # MAC der NIC (bei libvirt-VM wird diese gesetzt)
MACHINE_NETWORK="192.168.122.0/24"

# --- Disk ---------------------------------------------------------------------
# Ziel-Disk fuer die Installation (VM: /dev/vda, Bare Metal z.B. /dev/nvme0n1
# oder besser /dev/disk/by-id/...)
INSTALL_DISK="/dev/vda"

# --- Zugang -------------------------------------------------------------------
SSH_PUBKEY_FILE="${HOME}/.ssh/id_ed25519.pub"

# --- Arbeitsverzeichnisse -----------------------------------------------------
BIN_DIR="./bin"
WORK_DIR="./work"
